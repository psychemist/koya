# ============================================================
# Koya Talent — AI Operations Reporting System
#
# Copy to .env and fill in. .env is gitignored; this file is not.
#   cp .env.example .env
#
# Then generate the dashboard's config:
#   node 2/build/harness/build-dashboard-config.js
#
# WHY EVERY NAME IS PREFIXED IK E_
# The workflow runs on a SHARED n8n instance, where the environment is shared
# with every other workflow on it. A bare SUPABASE_URL there is a name
# collision waiting to happen, and the failure it produces — a workflow
# writing to somebody else's project — is not one you would spot from the
# execution log. The prefix is the whole fix.
# ============================================================

# Your project URL — Supabase → Project Settings → Data API.
# Not a secret. Read by the dashboard build and by the workflow.
IKE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# The PUBLISHABLE key — Supabase → Project Settings → API Keys.
# Starts with sb_publishable_. This is the key the browser dashboard uses.
#
# It is designed to be public: it reaches the browser and anyone who opens
# the page can read it out of devtools. Keeping it here rather than in
# index.html is about rotation and not committing project identifiers — it
# is NOT what makes it safe. Row level security is. See supabase/schema.sql.
#
# Legacy `anon` JWT keys (eyJhbGciOi…) still work and the dashboard still
# accepts them, but they are deprecated. Migrate to sb_publishable_.
IKE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY

# ------------------------------------------------------------
# Server-side only. NEVER put these in the dashboard config.
# ------------------------------------------------------------

# The SECRET key — starts with sb_secret_. Replaces the legacy service_role
# key. It bypasses row level security entirely.
#
# The workflow does NOT read this from here: it lives in n8n's credential
# store (Supabase account → Service Role Secret). It is listed only so the
# full set of what the system needs is documented in one place.
IKE_SUPABASE_SECRET_KEY=sb_secret_YOUR_SECRET_KEY

# Anchor for the reporting window, read by Resolve Reporting Period. The
# sample sources cover Jan 2025–Jun 2026, so the dataset horizon is what you
# want while they are the source. Set it to `today` when the sources go live.
#
# There is no fallback date in the code: leave this unset and every window
# anchors to the real clock, comes back empty, and the run says so loudly.
IKE_KOYA_REFERENCE_DATE=2026-06-30

# Optional. Leave empty to keep the dashboard strictly read-only — the Run
# now button then explains that refresh is not wired up rather than
# disappearing. Setting it publishes the webhook URL to anyone who opens the
# page, so only do that behind an authenticated host.
IKE_N8N_WEBHOOK_URL=

# ============================================================
# DEPLOYING THE DASHBOARD TO VERCEL
#
# There is no .env in a deployment — it is gitignored, which is the point —
# so the same three values are set as Environment Variables on the Vercel
# project, and the build step writes config.js from them:
#
#   Root Directory   2/build/dashboard
#   Build Command    node build-config.js      (already in vercel.json)
#   Output Directory .                         (already in vercel.json)
#
#   SUPABASE_URL                 https://YOUR-PROJECT-REF.supabase.co
#   SUPABASE_PUBLISHABLE_KEY     sb_publishable_…
#   N8N_WEBHOOK_URL              (optional — see the warning above)
#
# The IKE_ prefix is accepted there too, and takes precedence, so one set of
# names works everywhere. Rotating a key is an edit in the Vercel dashboard
# plus a redeploy; index.html never changes and no key is ever committed.
# ============================================================
