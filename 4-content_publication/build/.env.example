# Koya Content Desk — copy to .env.local and fill in.
# .env.local is gitignored. This file is committed and must NEVER carry a value.

# ============================================================
# SUPABASE
#
# Two different things, and conflating them is the classic mistake:
#
#   DATABASE_URL          the Postgres connection string. The app uses this,
#                         server-side only, via `pg`. It connects as a
#                         privileged role, so it BYPASSES row level security.
#
#   SUPABASE_PUBLISHABLE   sb_publishable_… — resolves to the `anon` role and is
#                         designed to be public. This app never ships it to the
#                         browser, but a Supabase project exposes a PostgREST
#                         Data API by default, so anyone who learns the project
#                         ref can try it. That is what RLS is defending against.
#
# See db/migrations/0001_init.sql — RLS is enabled on every table with NO anon
# policy at all. Week 2 needed anon read policies because its dashboard queried
# Postgres directly from the browser. This app does not, so anon gets nothing.
#
# Supabase → Project Settings → Database → Connection string → URI (pooled).
# ============================================================
DATABASE_URL=

# Optional. Only needed if you enable the Data API. Recorded here so the
# security posture is documented in one place, not so the app reads it.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# ---------- required ----------
ANTHROPIC_API_KEY=             # planning, drafting, adaptation, judging
APP_BASE_URL=http://localhost:3000
SESSION_SECRET=                # 32+ random bytes; signs session cookies

# ---------- research ----------
FIRECRAWL_API_KEY=             # primary scrape/search. Absent -> falls back to
                               # Claude web_fetch, which costs nothing beyond tokens.

# ---------- notifications ----------
# The app emits ONE signed event per state change; n8n fans it out to email
# and to the two Discord channels. The Resend key and both Discord webhook
# URLs live in n8n's CREDENTIAL STORE, not here — moving them out of this
# process is the point, because the app cannot leak what it never holds.
#
# Workflow: n8n/koya-notifications.json
N8N_NOTIFY_WEBHOOK_URL=        # production webhook URL from that workflow
N8N_NOTIFY_SECRET=             # shared secret; signs the payload (HMAC-SHA256).
                               # Without it the webhook is an open relay into
                               # the team's Discord.

# THE EMAIL INSIDE n8n IS GMAIL, NOT RESEND, and that is deliberate.
#
# Resend will not deliver to an arbitrary recipient until you have verified a
# DOMAIN. With its shared onboarding@resend.dev sender it accepts the API call,
# returns a message id, and delivers to the account owner and nobody else. Every
# notification addressed to anyone outside the project was therefore accepted
# and silently never arrived, which is the exact false success this system is
# built to refuse.
#
# So koya-notifications.json sends through a GMAIL node: it sends as a real
# mailbox, needs no domain, and costs nothing.
#   n8n -> Credentials -> New -> "Gmail OAuth2 API" -> sign in with the account
#   you want the mail to come from, then open both workflow JSON files and set
#   the Gmail node's credential to it.
# Gmail caps at a few hundred recipients a day. That is the real limit of this
# lane and it is stated on the admin page.

# FALLBACK LANE, third in line. Used only when the whole n8n workflow is
# unreachable. Discord is lost in that case; the email still goes, because the
# person who has to act not being told is the failure that actually stops work.
# Needs a verified domain to reach anyone but the Resend account owner.
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=             # e.g. "Koya Content Desk <desk@example.com>"

# ---------- Discord, inside n8n ----------
#
# Matches 3/build/n8n/koya-proposal-delivery.json exactly: a native Discord
# node with authentication "webhook", pointed at a CREDENTIAL, not a raw URL
# read out of a workflow variable. n8n -> Credentials -> New -> "Discord
# Webhook API" -> paste the channel's webhook URL there. Two credentials are
# needed, one per channel:
#   "Discord webhook — content-errors"   used by koya-notifications.json's
#                                         error branch and by
#                                         koya-queue-tick.json's alert
#   "Discord webhook — content-success"  used by koya-notifications.json's
#                                         success branch
# The URL then lives only in n8n's encrypted credential store: never in this
# file, never in a workflow's own JSON, never in a Variables list an admin
# could browse. Nothing here reads DISCORD_WEBHOOK_ERROR or
# DISCORD_WEBHOOK_SUCCESS as an app or n8n variable any more.

# ---------- newsletter publishing ----------
# A DIFFERENT job from notifications, so a different webhook: this one sends
# approved content to the subscriber list rather than telling a colleague the
# pipeline is waiting on them. Same reasoning, same Gmail-first order.
#
# Workflow: n8n/koya-newsletter.json  (webhook path: koya-newsletter)
N8N_PUBLISH_WEBHOOK_URL=
N8N_PUBLISH_SECRET=
#
# KOYA_NOTIFY_SECRET, KOYA_PUBLISH_SECRET, KOYA_TICK_KEY and KOYA_APP_URL all
# have to be set on the n8n instance, and each workflow reads them the same
# way 3/build/n8n/koya-proposal-delivery.json reads its own webhook secret:
# $env first, then $vars, each lookup wrapped so a BLOCKED $env (n8n Cloud has
# none at all; self-hosted blocks it by default) fails over to Variables
# instead of throwing and killing the node outright. Set them as:
#   n8n Settings -> Variables               works on every instance
#   or process environment with
#   N8N_BLOCK_ENV_ACCESS_IN_NODE=false      self-hosted only, and only if
#                                           you have explicitly allowed it
# Every one of these fails CLOSED when unreadable: the workflow throws, which
# n8n reports as a failed execution, rather than running unauthenticated.

# ---------- demo ----------
# The password `npm run seed` gives all three accounts, and the one the
# sign-in screen prints. Change it and re-seed to invalidate what is printed.
SEED_PASSWORD=
# false hides the click-to-fill demo accounts on the sign-in screen entirely.
DEMO_ACCOUNTS=true
# Lets the admin account move its session into the seeded manager or editor
# and back, so one person can walk both sides of the approval gate. It switches
# IDENTITY, not role, so separation of duties still holds. false removes it.
DEMO_ROLE_SWITCH=true

# ============================================================
# PUBLISHING
#
# All optional. A channel with no credentials records `blocked` on the queue
# row, never a fake `sent`, and the request screen offers the free manual
# route instead.
# ============================================================

# ---------- LinkedIn: FREE, self-serve, about ten minutes ----------
#
# Posting to your OWN member profile needs no partner approval. The queue
# everybody gets stuck in is for COMPANY PAGES and posting on behalf of other
# people, and this app does neither.
#
#  1. https://www.linkedin.com/developers/apps  ->  Create app
#     It requires a LinkedIn Company Page you administer, and a logo. A
#     throwaway page is fine; it is only used to own the app.
#
#  2. The app's PRODUCTS tab -> add BOTH of these. Each grants instantly,
#     with no review and no form:
#         - "Share on LinkedIn"                            (gives w_member_social)
#         - "Sign In with LinkedIn using OpenID Connect"    (gives openid, profile)
#     Do NOT request "Marketing Developer Platform". That is the partner
#     queue, it is not accepting new applicants, and you do not need it.
#
#  3. The app's AUTH tab:
#         - copy Client ID and Client Secret
#         - under "Authorized redirect URLs" add:
#             https://oauth.pstmn.io/v1/callback
#
#  4. Same AUTH tab -> "OAuth 2.0 tools" -> Create token.
#     Tick w_member_social, openid and profile. It returns an access token
#     valid for 60 days. That is LINKEDIN_ACCESS_TOKEN below.
#
#  5. Turn the token into your member URN:
#         curl -H "Authorization: Bearer <the token>" \
#              https://api.linkedin.com/v2/userinfo
#     Take the "sub" field from the JSON and set:
#         LINKEDIN_MEMBER_URN=urn:li:person:<sub>
#
# The token expires after 60 days. When it does, the connector records
# `linkedin_auth_401` on the queue row rather than reporting a send.
LINKEDIN_ACCESS_TOKEN=         # from step 4. w_member_social scope
LINKEDIN_MEMBER_URN=           # from step 5. urn:li:person:xxxxxxxx

# ---------- X: THERE IS NO FREE ROUTE. Leave these blank unless you mean it ----------
#
# The free tier ended on 6 February 2026. Pay-per-use is the only self-serve
# option: $0.015 per post, and $0.20 if the post contains a link. Every post
# this system writes contains a link unless the request opted out of it, and
# $0.20 is roughly 45% of what producing the whole content pack costs.
#
#  1. https://developer.x.com/en/portal/dashboard  ->  create a Project, then
#     an App inside it.
#
#  2. App -> "User authentication settings" -> Set up.
#     Set App permissions to READ AND WRITE. Do this BEFORE step 3: an access
#     token generated while the app is read-only stays read-only, and every
#     post then fails with 403 until you regenerate it.
#
#  3. App -> "Keys and tokens" tab:
#         Consumer Keys            -> X_API_KEY and X_API_SECRET
#         Access Token and Secret  -> Generate -> X_ACCESS_TOKEN and X_ACCESS_SECRET
#     The secrets are shown ONCE. Regenerating is free, so losing one is not
#     a problem, but it invalidates the old pair.
#
#  4. Portal -> Settings -> Usage -> add a payment method.
#     Without one, posting returns HTTP 402 and the queue records
#     `x_payment_required` rather than retrying into a loop.
#
# WITH FEATURE_X_PUBLISH=false (the default) none of this is needed. The post
# is still researched, written, checked and approved; the queue records
# `queued_manual`, and the request and queue screens give you a one-click,
# pre-filled X composer that costs nothing.
X_API_KEY=                     # Consumer Keys -> API Key
X_API_SECRET=                  # Consumer Keys -> API Key Secret
X_ACCESS_TOKEN=                # Access Token and Secret -> Access Token
X_ACCESS_SECRET=               # Access Token and Secret -> Access Token Secret

# ---------- image generation (decision B-6, requester override) ----------
IMAGE_PROVIDER=none            # openai | stability | none  (none -> honest "not configured")
IMAGE_API_KEY=

# ---------- behaviour ----------
PROMPT_VERSION=2026-09-16.1
EVAL_SCHEMA_VERSION=1          # frozen: bumping invalidates Claude's grammar cache
FEATURE_X_PUBLISH=false        # $0.20 per post containing a link — opt in per request
SOLO_OPERATOR_OVERRIDE=false   # true lets a requester approve their own work;
                               # every approval it enables is stamped on the row
