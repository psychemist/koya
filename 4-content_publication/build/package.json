{
  "name": "koya-content-desk",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AI content research and publishing agent for Koya Talent. Claude researches, plans, drafts and adapts; deterministic gates and a human editor decide what ships.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "migrate": "node --import tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "seed": "node --import tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "calibrate": "node --import tsx --env-file-if-exists=.env.local scripts/calibrate.ts",
    "sample": "node --import tsx --env-file-if-exists=.env.local scripts/sample-pack.ts",
    "test:integration": "node --import tsx --env-file-if-exists=.env.local --test tests/integration/*.test.ts",
    "test:stress": "node --import tsx --env-file-if-exists=.env.local tests/stress/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@supabase/supabase-js": "^2.58.0",
    "next": "^15.5.4",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "resend": "^6.1.2",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2"
  }
}
