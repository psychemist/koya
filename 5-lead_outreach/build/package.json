{
  "name": "koya-lead-desk",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AI lead research and outreach agent for Koya Talent. Claude refines the ICP, discovers and qualifies companies with source evidence, and drafts review-ready outreach. Nothing is sent.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "migrate": "node --import tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "seed": "node --import tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "worker": "node --import tsx --env-file-if-exists=.env.local worker/index.ts",
    "discover:smoke": "node --import tsx --env-file-if-exists=.env.local scripts/discover-smoke.ts",
    "notify:smoke": "node --import tsx --env-file-if-exists=.env.local scripts/notify-smoke.ts",
    "sample": "node --import tsx --env-file-if-exists=.env.local scripts/sample-pack.ts",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "test:integration": "node --import tsx --env-file-if-exists=.env.local --test tests/integration/*.test.ts",
    "overlap": "node --import tsx --env-file-if-exists=.env.local scripts/overlap.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.0",
    "@anthropic-ai/sdk": "^0.93.0",
    "@mendable/firecrawl-js": "^4.41.0",
    "apify-client": "^2.25.0",
    "next": "^15.5.4",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "resend": "^6.1.2",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2"
  }
}
