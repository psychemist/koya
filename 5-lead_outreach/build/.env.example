# --- Database (both services) ---
# Supabase > Project Settings > Database > Connection string > URI (pooled).
# Starts postgresql://. The https://<ref>.supabase.co value is the API URL and is NOT this.
DATABASE_URL=postgresql://postgres.YOUR-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# --- Claude (worker only) ---
ANTHROPIC_API_KEY=sk-ant-YOUR-KEY
AGENT_MODEL=claude-sonnet-5
SCREEN_MODEL=claude-haiku-4-5
# Reasoning depth: low | medium | high | xhigh | max. The SDK default is high.
# Output is where this agent's money goes, so this is the knob that moves it.
AGENT_EFFORT=high
AGENT_MAX_TURNS=60
AGENT_MAX_BUDGET_USD=1.50
# Across every run in a UTC day. Claude is roughly 89% of what a run costs and
# was the only provider with no ceiling across runs, so ten runs was $15 with
# nothing to stop it.
#
# MUST be larger than AGENT_MAX_BUDGET_USD. A daily cap below a single run's
# ceiling refuses every run for ever while reading like an ordinary exhausted
# day, so the worker names that as a misconfiguration rather than a budget.
DAILY_CLAUDE_CAP_USD=6.00

# --- Apify (worker only). TEAM account token, not your personal one. ---
# Switch to the team account in the Apify Console before generating this.
APIFY_TOKEN=apify_api_YOUR-TEAM-TOKEN
APIFY_EXPECTED_ACCOUNT=your-team-account   # asserted at worker boot

# PINNED ACTOR. Prices read from the Apify API on 2026-09-24, not the listing
# page: GET /v2/acts/harvestapi~linkedin-company-search -> data.pricingInfos.
#
#   harvestapi/linkedin-company-search
#
#   pricingModel: PAY_PER_EVENT. That is also the answer to "is this a rental
#   actor": a rental actor reports FLAT_PRICE_PER_MONTH and bills a monthly fee
#   on enable whether or not it is ever run. This one reports no such field.
#   Re-check with:
#     curl -H "Authorization: Bearer $APIFY_TOKEN" \
#       https://api.apify.com/v2/acts/harvestapi~linkedin-company-search \
#       | jq '.data.pricingInfos[-1].pricingModel'
#
#   Charge event         FREE/BRONZE/SILVER   GOLD+ (this account is BRONZE)
#     apify-actor-start        $0.001              $0.0005
#     short-company            $0.002              $0.001
#     full-company             $0.004              $0.003
#
# This account is AA_Training_Program_Pod1, plan STARTER, tier BRONZE, so the
# left column applies. Verify the tier with:
#   curl -H "Authorization: Bearer $APIFY_TOKEN" \
#     https://api.apify.com/v2/users/me | jq '.data.plan | {id, tier}'
#
# The price below MUST be the full-company row, because buildActorCall pins
# scraperMode to 'full'. Short mode returns no website, so every row it
# produces is dropped as an aggregator and the run pays for nothing. Setting
# this to the short-company price under-reserves by half, and the ledger is
# what both caps below are measured against.
APIFY_ACTOR_ID=apify-actor-name
APIFY_ACTOR_PRICE_PER_RESULT_USD=0.004

# Charged once per actor run whatever it returns, so a search that finds
# nothing still costs this. Counted in the reservation because one run may
# search more than once.
APIFY_ACTOR_START_USD=0.001
RUN_CANDIDATE_BUDGET=40
RUN_APIFY_CAP_USD=0.30
DAILY_APIFY_CAP_USD=1.50

# --- Firecrawl (worker only) ---
FIRECRAWL_API_KEY=fc-YOUR-KEY
RUN_SCRAPE_BUDGET=30

# --- Notifications (worker only). n8n is primary; Resend is the fallback. ---
# The Discord webhook URLs and the Gmail credential live in n8n's credential
# store, NOT here, so the worker cannot leak what it never holds.
#
# Resend is the exception and it is deliberate: it is the lane that has to work
# when n8n does not answer, so it cannot live inside n8n. A fallback hosted by
# the thing that just failed is not a fallback.
N8N_LEAD_NOTIFY_URL=https://YOUR-N8N-HOST/webhook/koya-lead-notify
N8N_LEAD_NOTIFY_SECRET=generate-with-openssl-rand-hex-32   # also set as KOYA_LEAD_NOTIFY_SECRET in n8n
NOTIFY_TO=operator@example.com                             # comma separated
# FALLBACK ONLY. Used when the n8n lane is unreachable. Discord is lost in that case.
RESEND_API_KEY=re_YOUR-KEY
NOTIFY_FROM_EMAIL=Koya Lead Desk <onboarding@resend.dev>

# --- Web ---
APP_BASE_URL=http://localhost:3000
SESSION_SECRET=generate-with-openssl-rand-hex-32
