{
  "name": "koya-proposal-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AI proposal application for Koya Talent. Claude drafts, a salesperson revises, an approver signs off, the client receives.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "migrate": "node --import tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "seed": "node --import tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "test:e2e": "node --import tsx --env-file-if-exists=.env.local scripts/e2e.ts",
    "build:workflow": "node --import tsx n8n/build-workflow.ts",
    "smoke:claude": "node --import tsx --env-file-if-exists=.env.local scripts/smoke-claude.ts",
    "sample": "node --import tsx --env-file-if-exists=.env.local scripts/sample.ts",
    "verify:team": "node --import tsx --env-file-if-exists=.env.local scripts/verify-team.ts",
    "verify:activity": "node --import tsx --env-file-if-exists=.env.local scripts/verify-activity.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "docx": "^9.5.1",
    "mammoth": "^1.11.0",
    "next": "^15.5.4",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "resend": "^6.1.2",
    "unpdf": "^1.3.2",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2"
  }
}
