# ============================================================
# Koya Proposal Studio — Week 3
#
#   cp .env.example .env.local     then fill in.
#
# .env.local is gitignored (repo root .gitignore, bare `.env.local` pattern
# matches at any depth — verified with `git check-ignore -v`).
#
# NOTHING HERE IS PREFIXED NEXT_PUBLIC_. That is deliberate and load-bearing:
# any variable Next.js sees with that prefix is inlined into the JavaScript
# bundle the browser downloads. Every value below is read only inside route
# handlers and server components, so no key can reach a client. The one
# browser-visible value the app needs — its own base URL — it derives from the
# request headers instead of an env var.
# ============================================================

# ---------- Database ----------
# Neon pooled connection string. Project: koya-proposal-studio.
# The pooled host (-pooler) matters on serverless: each function invocation
# opens its own connection, and the direct endpoint runs out of slots long
# before pgbouncer does.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full

# ---------- Claude ----------
# console.anthropic.com -> API Keys. Server-side only.
ANTHROPIC_API_KEY=sk-ant-...

# ---------- Sessions ----------
# Signs the session cookie (HMAC-SHA256). Rotating it logs everyone out, which
# is the intended way to revoke every session at once.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SESSION_SECRET=

# ---------- Public origin ----------
# The canonical origin, used to build the client-facing proposal links that get
# emailed out. SET THIS IN PRODUCTION.
#
# Without it the app falls back to the request's own Host header, which is
# supplied by the caller. That value ends up inside a link carrying a live
# proposal token, emailed to a real client from the firm's own address — so a
# forged Host is a phishing link the system sends on the attacker's behalf.
# With APP_BASE_URL set, the header is never consulted.
#
# No trailing slash.
APP_BASE_URL=

# Optional. Extra hostnames this deployment legitimately answers to, comma
# separated, for when one deployment has several names and APP_BASE_URL cannot
# describe them all. Anything not listed here and not APP_BASE_URL is refused.
APP_ALLOWED_HOSTS=

# ---------- Delivery lane A: n8n ----------
# Optional. Empty means the app skips straight to lane B (Resend) and says so
# in the delivery record — it does not fail.
# The webhook is HMAC-signed with the shared secret below, so publishing the
# URL is not itself a way in.
#
# The SAME VALUE has to exist on the n8n side under the name
# IKE_KOYA_WEBHOOK_SECRET. Set it in n8n under Settings -> Variables, which
# works on Cloud and self-hosted alike; a Code node cannot read the process
# environment on n8n Cloud, and self-hosted blocks it unless the instance
# runs with N8N_BLOCK_ENV_ACCESS_IN_NODE=false. The names differ on purpose:
# each side owns its own naming, and only the value has to match.
N8N_PROPOSAL_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# ---------- Delivery lane B: Resend ----------
# Optional. Empty means the app records the delivery as blocked with a clear
# reason and offers a downloadable .eml — never a silent failure.
RESEND_API_KEY=
# The From address. onboarding@resend.dev works with no DNS setup, but Resend's
# free tier will then only deliver to the address that owns the account.
RESEND_FROM="Koya Talent <onboarding@resend.dev>"

# ---------- Demo accounts ----------
# Read by `npm run seed`, and printed on the sign-in page so a reviewer can get
# in without asking. Change them and re-seed to lock the app down.
SEED_SALESPERSON_EMAIL=sales@koya.demo
SEED_SALESPERSON_PASSWORD=
SEED_APPROVER_EMAIL=approvals@koya.demo
SEED_APPROVER_PASSWORD=
# The administrator. Required: adding colleagues, granting approval authority
# and deactivating leavers are admin-only, so a deployment without one has no
# account that can ever change who its approvers are.
SEED_ADMIN_EMAIL=admin@koya.demo
SEED_ADMIN_PASSWORD=
